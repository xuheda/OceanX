{
  "schema_version": 1,
  "vehicle_profile": "StandardVTOL",
  "vehicle_type": "StandardVTOL",
  "sensor_suite": [
    {
      "sensor_type": "ImuSensor",
      "sensor_name": "imu",
      "mount_frd": {"location_m": [0, 0, 0], "rotation_rpy_deg": [0, 0, 0]},
      "configuration": {
        "sample_rate_hz": 100,
        "ReturnBias": true,
        "AccelCov": [0.0004, 0.0004, 0.0004],
        "AngVelCov": [0.0001, 0.0001, 0.0001]
      }
    },
    {
      "sensor_type": "GpsSensor",
      "sensor_name": "gps",
      "mount_frd": {"location_m": [0, 0, 0], "rotation_rpy_deg": [0, 0, 0]},
      "configuration": {
        "sample_rate_hz": 5,
        "surface_reference": "mean",
        "validity": {
          "max_depth_m": 0.0,
          "valid_in_air": true,
          "valid_at_surface": true,
          "valid_underwater": false
        },
        "noise": {"position_covariance": [0.25, 0.25, 0.5], "depth_covariance": 0.25}
      }
    },
    {
      "sensor_type": "MagnetometerSensor",
      "sensor_name": "magnetometer",
      "mount_frd": {"location_m": [0, 0, 0], "rotation_rpy_deg": [0, 0, 0]},
      "configuration": {
        "sample_rate_hz": 20,
        "field": {"mode": "generated", "total_field_uT": 50, "inclination_deg": 60, "declination_deg": 0},
        "noise": {"sigma_uT": [0.05, 0.05, 0.05]}
      }
    },
    {
      "sensor_type": "TruthStateSensor",
      "sensor_name": "truth_state",
      "mount_frd": {"location_m": [0, 0, 0], "rotation_rpy_deg": [0, 0, 0]},
      "configuration": {
        "sample_rate_hz": 20,
        "mode": "full_state",
        "truth_source": "vehicle",
        "use_com": true,
        "_doc": "Diagnostics only; never feed truth into deployment control."
      }
    }
  ]
}

