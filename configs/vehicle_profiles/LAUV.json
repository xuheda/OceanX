{
  "schema_version": 1,
  "vehicle_profile": "LAUV",
  "vehicle_type": "LAUV",
  "sensor_suite": [
    {
      "sensor_type": "ImuSensor",
      "sensor_name": "imu",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 100,
        "ReturnBias": true,
        "AccelCov": [
          0.0004,
          0.0004,
          0.0004
        ],
        "AngVelCov": [
          0.0001,
          0.0001,
          0.0001
        ]
      }
    },
    {
      "sensor_type": "DvlSensor",
      "sensor_name": "dvl",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 5,
        "mode": "bottom_track",
        "beam_angle_deg": 22.5,
        "max_range_m": 1000,
        "min_valid_beams": 3,
        "noise": {
          "beam_velocity_sigma": 0.05,
          "range_sigma": 0.1
        }
      }
    },
    {
      "sensor_type": "DepthSensor",
      "sensor_name": "depth",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 20,
        "surface_reference": "mean",
        "invalid_when_air": true,
        "noise": {
          "depth_covariance": 0.01
        }
      }
    },
    {
      "sensor_type": "GpsSensor",
      "sensor_name": "gps",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 1,
        "surface_reference": "instantaneous",
        "validity": {
          "max_depth_m": 0.05,
          "valid_in_air": true,
          "valid_at_surface": true,
          "valid_underwater": false
        },
        "noise": {
          "position_covariance": [
            1,
            1,
            1
          ],
          "depth_covariance": 0.25
        }
      }
    },
    {
      "sensor_type": "MagnetometerSensor",
      "sensor_name": "magnetometer",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 20,
        "field": {
          "mode": "generated",
          "total_field_uT": 50,
          "inclination_deg": 60,
          "declination_deg": 0
        },
        "noise": {
          "sigma_uT": [
            0.05,
            0.05,
            0.05
          ]
        }
      }
    },
    {
      "sensor_type": "TruthStateSensor",
      "sensor_name": "truth_state",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 20,
        "mode": "full_state",
        "truth_source": "vehicle",
        "use_com": true,
        "_doc": "Diagnostics only: compare ROS navigation state against UE truth; never feed this into deployment control."
      }
    },
    {
      "sensor_type": "PassiveSonarSensor",
      "sensor_name": "passive_sonar",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 10,
        "NumTargets": 1,
        "target_name": "target",
        "MaxDistance": 1000,
        "noise": {
          "seed": 12345,
          "bearing_sigma": [
            0.01,
            0.01
          ]
        }
      }
    },
    {
      "sensor_type": "DebugTargetDetectionSensor",
      "sensor_name": "target_detection",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 10,
        "target_name": "target",
        "target_id": 0,
        "max_distance_m": 1000,
        "use_state_history": false,
        "check_visible": false
      }
    },
    {
      "sensor_type": "AcousticCommunicationSensor",
      "sensor_name": "acoustic_comms",
      "mount_frd": {
        "location_m": [
          0,
          0,
          0
        ],
        "rotation_rpy_deg": [
          0,
          0,
          0
        ]
      },
      "configuration": {
        "sample_rate_hz": 10,
        "max_neighbors": 8,
        "max_payload_floats": 8,
        "tx_rate_hz": 10,
        "auto_transmit": true,
        "auto_payload_from_passive_sonar": true
      }
    }
  ]
}
